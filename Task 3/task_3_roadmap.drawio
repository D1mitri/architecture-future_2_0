        <mxCell id="ejPvCT8Pstb-p8VBIJuH-36" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Продуктовый бэклог" vertex="1">
