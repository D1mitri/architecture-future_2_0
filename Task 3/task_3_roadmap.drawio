        <mxCell id="xl-GklPO_LQGrU1CK8J2-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="Вне рамок года выкидываем:&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Power Builder - будет заменен полноценно новым порталом&lt;/div&gt;&lt;div&gt;SQL Server - будет выполнен переезд в Postgres&lt;/div&gt;&lt;div&gt;Apache Camel - команда разработки будет изучать другое решение&lt;/div&gt;" vertex="1">
